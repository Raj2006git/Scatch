<%- include('./partials/header') %>

<div class="w-full min-h-screen bg-zinc-100 px-10 py-10">

    <div class="max-w-6xl mx-auto flex gap-10">

        <!-- Left Section -->
        <div class="w-[30%] bg-white rounded-xl shadow-md p-6">

            <div class="flex flex-col items-center gap-4">

                <div class="w-28 h-28 rounded-full bg-zinc-300 overflow-hidden">
                    <img
                        class="w-full h-full object-cover"
                        src="https://api.dicebear.com/7.x/fun-emoji/svg?seed=Raj"
                        alt="profile"
                    >
                </div>

                <div class="text-center">
                    <h2 class="text-2xl font-semibold">
                        <%= user.fullname %>
                    </h2>

                    <p class="text-zinc-500 mt-1">
                        <%= user.email %>
                    </p>
                </div>

            </div>

            <div class="mt-10 flex flex-col gap-4">

                <a
                    href="/shop"
                    class="w-full bg-black text-white py-3 rounded-lg text-center"
                >
                    Continue Shopping
                </a>

                <a
                    href="/cart"
                    class="w-full border border-black py-3 rounded-lg text-center"
                >
                    View Cart
                </a>

                <a
                    href="/logout"
                    class="w-full bg-red-500 text-white py-3 rounded-lg text-center"
                >
                    Logout
                </a>

            </div>

        </div>

        <!-- Right Section -->
        <div class="w-[70%] flex flex-col gap-8">

            <!-- Account Details -->
            <div class="bg-white rounded-xl shadow-md p-8">

                <h2 class="text-2xl font-semibold mb-6">
                    Account Details
                </h2>

                <div class="grid grid-cols-2 gap-6">

                    <div>
                        <h4 class="text-zinc-500 mb-2">Full Name</h4>
                        <div class="border rounded-lg px-4 py-3 bg-zinc-50">
                            <%= user.fullname %>
                        </div>
                    </div>

                    <div>
                        <h4 class="text-zinc-500 mb-2">Email</h4>
                        <div class="border rounded-lg px-4 py-3 bg-zinc-50">
                            <%= user.email %>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Order Summary -->
            <div class="bg-white rounded-xl shadow-md p-8">

                <h2 class="text-2xl font-semibold mb-6">
                    Cart Summary
                </h2>

                <div class="flex justify-between items-center border-b pb-4">
                    <h3 class="text-lg">Items in Cart</h3>

                    <span class="font-semibold text-xl">
                        <%= user.cart.length %>
                    </span>
                </div>

                <div class="mt-5 flex flex-col gap-4">

                    <% user.cart.forEach(function(item){ %>

                        <div class="flex items-center justify-between bg-zinc-100 rounded-lg p-4">

                            <div class="flex items-center gap-4">

                                <div
                                    class="w-16 h-16 rounded-md overflow-hidden flex items-center justify-center bg-[<%= item.product.bgcolor %>]"
                                >
                                    <img
                                        class="h-12"
                                        src="data:image/jpeg;base64,<%= item.product.image.toString('base64') %>"
                                        alt=""
                                    >
                                </div>

                                <div>
                                    <h3 class="font-semibold text-lg">
                                        <%= item.product.name %>
                                    </h3>

                                    <p class="text-zinc-500">
                                        Quantity: <%= item.quantity %>
                                    </p>
                                </div>

                            </div>

                            <div class="text-lg font-semibold">
                                ₹ <%= item.product.price * item.quantity %>
                            </div>

                        </div>

                    <% }) %>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>
